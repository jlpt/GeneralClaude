@@ -1051,3 +1056,158 @@ void gcdialog_defrag(void) {
 void func_80311714(int next_state){
     g_Dialog.unk128_3 = next_state;
 }
+
+/* ------------------------------------------------------------------------
+ * Turning Point 2 homage - boot-time scripted scene.
+ * Runs once per boot from gsworld_update().
+ * ---------------------------------------------------------------------- */
+enum tp2_state_e {
+    TP2_STATE_0_SETTLE,
+    TP2_STATE_1_TITLE,
+    TP2_STATE_2_CAMP,
+    TP2_STATE_3_BLACKOUT,
+    TP2_STATE_4_DREAM,
+    TP2_STATE_5_WAKING,
+    TP2_STATE_6_WAKE,
+    TP2_STATE_7_OUTRO,
+    TP2_STATE_8_DONE
+};
+
+enum tp2_trigger_e {
+    TP2_TRIG_1_ARRIVAL = 1,
+    TP2_TRIG_2_MUMBO_DOWN,
+    TP2_TRIG_3_EGGS,
+    TP2_TRIG_4_BLOW,
+    TP2_TRIG_5_MENDED,
+    TP2_TRIG_6_LEAVE
+};
+
+s32 tp2_state;
+s32 tp2_timer;
+s32 tp2_dialogQueued;
+s32 tp2_dialogDone;
+
+static void tp2_onDialogDone(ActorMarker *caller, s32 text_id, s32 arg2) {
+    tp2_dialogDone = TRUE;
+}
+
+static void tp2_onTrigger(ActorMarker *caller, s32 text_id, s32 trigger) {
+    switch (trigger) {
+        case TP2_TRIG_1_ARRIVAL:
+            func_802BB3DC(0, 12.0f, 0.92f);
+            gcsfx_play(SFX_B5_THUNDERBOLT);
+            break;
+        case TP2_TRIG_2_MUMBO_DOWN:
+            func_802BB3DC(0, 30.0f, 0.9f);
+            gcsfx_play(SFX_1B_EXPLOSION_1);
+            break;
+        case TP2_TRIG_3_EGGS:
+            gcsfx_play(SFX_8A_ALTERNATIVE_EGG_SHOT);
+            gcsfx_play(SFX_30_MAGIC_POOF);
+            break;
+        case TP2_TRIG_4_BLOW:
+            func_802BB3DC(0, 60.0f, 0.9f);
+            gcsfx_play(SFX_5D_BANJO_RAAOWW);
+            if (item_getCount(ITEM_14_HEALTH) > 1) {
+                item_adjustByDiffWithHud(ITEM_14_HEALTH, 1 - item_getCount(ITEM_14_HEALTH));
+            }
+            break;
+        case TP2_TRIG_5_MENDED:
+            gcsfx_play(SFX_A6_MAGICAL_FINISH);
+            break;
+        case TP2_TRIG_6_LEAVE:
+            gcsfx_play(SFX_EA_GRUNTY_LAUGH_1);
+            break;
+    }
+}
+
+/* Keeps trying to open the dialog until the dialog system is free. */
+static void tp2_playDialog(s32 index) {
+    if (!tp2_dialogQueued) {
+        tp2_dialogDone = FALSE;
+        if (gcdialog_showDialog(TP2_TEXT_BASE + index, 0xE, NULL, NULL, (void *)tp2_onDialogDone, (void *)tp2_onTrigger)) {
+            tp2_dialogQueued = TRUE;
+        }
+    }
+}
+
+static bool tp2_dialogFinished(void) {
+    if (tp2_dialogQueued && tp2_dialogDone && !gcdialog_hasCurrentTextId()) {
+        tp2_dialogQueued = FALSE;
+        tp2_dialogDone = FALSE;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void tp2_setState(s32 next) {
+    tp2_state = next;
+    tp2_timer = 0;
+}
+
+void tp2_update(void) {
+    if (tp2_state == TP2_STATE_8_DONE || getGameMode() != GAME_MODE_3_NORMAL) {
+        return;
+    }
+
+    tp2_timer++;
+    switch (tp2_state) {
+        case TP2_STATE_0_SETTLE: /* let the level finish fading in */
+            if (tp2_timer > 60) {
+                tp2_setState(TP2_STATE_1_TITLE);
+            }
+            break;
+
+        case TP2_STATE_1_TITLE:
+            print_bold_spaced(0x30, 0x50, "TURNING POINT 2");
+            if (tp2_timer > 120) {
+                tp2_setState(TP2_STATE_2_CAMP);
+            }
+            break;
+
+        case TP2_STATE_2_CAMP:
+            tp2_playDialog(0);
+            if (tp2_dialogFinished()) {
+                tp2_setState(TP2_STATE_3_BLACKOUT);
+            }
+            break;
+
+        case TP2_STATE_3_BLACKOUT:
+            print_bold_spaced(0x80, 0x50, "...");
+            if (tp2_timer > 75) {
+                tp2_setState(TP2_STATE_4_DREAM);
+            }
+            break;
+
+        case TP2_STATE_4_DREAM:
+            tp2_playDialog(1);
+            if (tp2_dialogFinished()) {
+                tp2_setState(TP2_STATE_5_WAKING);
+            }
+            break;
+
+        case TP2_STATE_5_WAKING:
+            if (tp2_timer == 1) {
+                gcsfx_play(SFX_A6_MAGICAL_FINISH);
+                item_adjustByDiffWithHud(ITEM_14_HEALTH, item_getCount(ITEM_15_HEALTH_TOTAL) - item_getCount(ITEM_14_HEALTH));
+            }
+            if (tp2_timer > 45) {
+                tp2_setState(TP2_STATE_6_WAKE);
+            }
+            break;
+
+        case TP2_STATE_6_WAKE:
+            tp2_playDialog(2);
+            if (tp2_dialogFinished()) {
+                tp2_setState(TP2_STATE_7_OUTRO);
+            }
+            break;
+
+        case TP2_STATE_7_OUTRO:
+            print_bold_spaced(0x28, 0x50, "TO BE CONTINUED");
+            if (tp2_timer > 150) {
+                tp2_setState(TP2_STATE_8_DONE);
+            }
+            break;
+    }
+}
