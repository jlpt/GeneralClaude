diff --git a/src/core2/gc/surreal.inc b/src/core2/gc/surreal.inc
new file mode 100644
index 0000000..b28b51a
--- /dev/null
+++ b/src/core2/gc/surreal.inc
@@ -0,0 +1,280 @@
+/* "Surreal" mod - dream state and sky effects.
+ * This file is #included at the end of sky.c. It must not end in ".c": the Makefile
+ * compiles every *.c under src/ on its own. */
+#include "core2/surreal.h"
+
+extern f32 sinf(f32);
+extern f32 cosf(f32);
+
+#define SURREAL_DTOR 0.017453292f
+
+/* .bss */
+static f32 sSurrealTime;
+static BKModelBin *sSurrealSkyBins[2];
+static f32 sSurrealSavedRotation[3];
+static f32 sSurrealSavedFovy;
+static u8  sSurrealJellySkip;
+#ifdef SURREAL_TEST_MAP
+static s32 sSurrealDebugResized;
+static s32 sSurrealDebugGiants;
+static s32 sSurrealDebugTiny;
+static char sSurrealDebugText[0x40];
+static char sSurrealDebugGravityText[0x20];
+#endif
+
+/* .code */
+f32 surreal_getTime(void) {
+    return sSurrealTime;
+}
+
+void surreal_update(void) {
+    sSurrealTime += time_getDelta();
+    if (sSurrealTime > 7200.0f) {
+        sSurrealTime -= 7200.0f;
+    }
+#ifdef SURREAL_TEST_MAP
+    /* dev only: how many enemies were resized (total, giants, tiny) and the player's gravity */
+    sSurrealDebugText[0] = 0;
+    bk_strcat(sSurrealDebugText, "R ");
+    bk_strIToA(sSurrealDebugText, sSurrealDebugResized);
+    bk_strcat(sSurrealDebugText, " G ");
+    bk_strIToA(sSurrealDebugText, sSurrealDebugGiants);
+    bk_strcat(sSurrealDebugText, " T ");
+    bk_strIToA(sSurrealDebugText, sSurrealDebugTiny);
+    print_bold_spaced(0x20, 0xC0, (u8 *) sSurrealDebugText);
+    sSurrealDebugGravityText[0] = 0;
+    bk_strcat(sSurrealDebugGravityText, "GRAV ");
+    bk_strIToA(sSurrealDebugGravityText, (s32) -baphysics_get_gravity());
+    print_bold_spaced(0x20, 0xA8, (u8 *) sSurrealDebugGravityText);
+#endif
+#ifdef SURREAL_TEST_SLIDESHOW
+    {   /* dev only: hop through a list of {map, exit} pairs, a few seconds each */
+        static s16 slides[][2] = {SURREAL_TEST_SLIDESHOW};
+        static s32 index = 0;
+        static f32 timer = 0.0f;
+
+        timer += time_getDelta();
+        if (timer > SURREAL_TEST_SLIDE_SECONDS && index < (s32)(sizeof(slides) / sizeof(slides[0]))) {
+            timer = 0.0f;
+            transitionToMap(slides[index][0], slides[index][1], 0);
+            index++;
+        }
+    }
+#endif
+}
+
+/* The oddity that drifts across each world's sky, picked by map id */
+static enum asset_e sSurrealSkyOddities[] = {
+    ASSET_35F_MODEL_JIGGY,
+    ASSET_46F_MODEL_CUCKOO_CLOCK,
+    ASSET_46E_MODEL_FISHBOWL,
+    ASSET_363_MODEL_HONEYCOMB,
+    ASSET_380_MODEL_PINK_EGG_LARGEST,
+    ASSET_3BB_MODEL_JINJO_YELLOW
+};
+#define SURREAL_SKY_ODDITY_COUNT (sizeof(sSurrealSkyOddities) / sizeof(sSurrealSkyOddities[0]))
+
+void surreal_sky_load(void) {
+    /* the eye that watches every open sky */
+    sSurrealSkyBins[0] = assetcache_get(ASSET_37D_MODEL_CLAM_EYE);
+    sSurrealSkyBins[1] = assetcache_get(sSurrealSkyOddities[gsworld_getMap() % SURREAL_SKY_ODDITY_COUNT]);
+}
+
+void surreal_sky_free(void) {
+    s32 i;
+
+    for (i = 0; i < 2; i++) {
+        if (sSurrealSkyBins[i] != NULL) {
+            assetcache_release(sSurrealSkyBins[i]);
+            sSurrealSkyBins[i] = NULL;
+        }
+    }
+}
+
+/* The sky no longer just spins around the vertical axis: it slowly rolls and nods */
+void surreal_sky_getTumble(f32 rotation[3]) {
+    f32 t = sSurrealTime;
+
+    rotation[0] += 22.0f * sinf(t * 0.11f);
+    rotation[1] += t * 2.0f;
+    rotation[2] += 35.0f * sinf(t * 0.07f + 1.0f);
+}
+
+static void __surreal_sky_drawObject(Gfx **gfx, Mtx **mtx, BKModelBin *model_bin, f32 camera_position[3],
+                                     f32 azimuth, f32 elevation, f32 distance, f32 scale, f32 rotation[3]) {
+    f32 position[3];
+    f32 horizontal;
+
+    if (model_bin == NULL) {
+        return;
+    }
+    horizontal = distance * cosf(elevation * SURREAL_DTOR);
+    position[0] = camera_position[0] + horizontal * sinf(azimuth * SURREAL_DTOR);
+    position[1] = camera_position[1] + distance * sinf(elevation * SURREAL_DTOR);
+    position[2] = camera_position[2] + horizontal * cosf(azimuth * SURREAL_DTOR);
+    /* drawn with the default depth mode (none), like the sky itself, so the whole world covers it */
+    modelRender_draw(gfx, mtx, position, rotation, scale, NULL, model_bin);
+}
+
+void surreal_sky_drawObjects(Gfx **gfx, Mtx **mtx, f32 camera_position[3]) {
+    f32 t = sSurrealTime;
+    f32 rotation[3];
+    f32 azimuth;
+    f32 elevation;
+
+    /* the eye: hangs high in the north-east, bobbing, always turned to the camera */
+    azimuth = 40.0f + 12.0f * sinf(t * 0.05f);
+    elevation = 38.0f + 6.0f * sinf(t * 0.13f);
+    /* the model's pupil faces +Y: tip it over and turn it back towards the camera */
+    rotation[0] = 90.0f + elevation;
+    rotation[1] = azimuth + 180.0f;
+    rotation[2] = 0.0f;
+    __surreal_sky_drawObject(gfx, mtx, sSurrealSkyBins[0], camera_position, azimuth, elevation, 6000.0f,
+                             58.0f + 5.0f * sinf(t * 0.9f), rotation);
+
+    /* the oddity: circles the horizon the other way, tumbling end over end */
+    azimuth = 200.0f - t * 3.0f;
+    elevation = 24.0f + 10.0f * sinf(t * 0.21f);
+    rotation[0] = t * 17.0f;
+    rotation[1] = t * 29.0f;
+    rotation[2] = t * 11.0f;
+    __surreal_sky_drawObject(gfx, mtx, sSurrealSkyBins[1], camera_position, azimuth, elevation, 6000.0f, 9.0f, rotation);
+}
+
+/* ---------------------------------------------------------------- camera
+ * The lens breathes (field of view, 40 to 46 degrees) and the horizon sways (roll, up to
+ * 4 degrees). Applied only for the duration of the world pass so the camera logic never
+ * sees the modified values. viewport_update() has a culling frustum widened to match. */
+void surreal_camera_begin(void) {
+    f32 t = sSurrealTime;
+    f32 rotation[3];
+
+    viewport_getRotation_vec3f(sSurrealSavedRotation);
+    sSurrealSavedFovy = viewport_getFOVy();
+
+    rotation[0] = sSurrealSavedRotation[0];
+    rotation[1] = sSurrealSavedRotation[1];
+    rotation[2] = sSurrealSavedRotation[2] + 3.0f * sinf(t * 0.37f) + 1.0f * sinf(t * 0.83f + 2.0f);
+#ifdef SURREAL_TEST_PITCH
+    /* dev only: aim the camera for screenshots. Elevation in degrees (up is positive) and a
+     * compass azimuth that advances SURREAL_TEST_YAW degrees per second for a panorama. */
+    rotation[0] = SURREAL_TEST_PITCH;
+    rotation[1] = 180.0f + SURREAL_TEST_YAW0 + SURREAL_TEST_YAW * t;
+#endif
+    viewport_setRotation_vec3f(rotation);
+    viewport_setFOVy(sSurrealSavedFovy + 3.0f + 3.0f * sinf(t * 0.29f));
+    viewport_update();
+}
+
+void surreal_camera_end(void) {
+    viewport_setRotation_vec3f(sSurrealSavedRotation);
+    viewport_setFOVy(sSurrealSavedFovy);
+    viewport_update();
+}
+
+/* ---------------------------------------------------------------- jelly
+ * Everything alive wobbles: taller-and-thinner, then shorter-and-fatter. The phase comes
+ * from where the thing stands, so a crowd ripples instead of pulsing in step, and
+ * anything that moves wobbles faster. Big objects wobble less so platforms stay usable. */
+void surreal_jelly_skipNext(void) {
+    sSurrealJellySkip = TRUE;
+}
+
+bool surreal_jelly_getScale(f32 position[3], f32 radius, f32 scale[3]) {
+    f32 amplitude;
+    f32 wave;
+
+    if (sSurrealJellySkip) {
+        sSurrealJellySkip = FALSE;
+        return FALSE;
+    }
+    amplitude = 0.13f;
+    if (radius > 150.0f) {
+        amplitude *= 150.0f / radius;
+    }
+    wave = sinf(sSurrealTime * 4.3f + (position[0] + position[2]) * 0.011f + position[1] * 0.007f);
+    scale[1] = 1.0f + amplitude * wave;
+    scale[0] = scale[2] = 1.0f - 0.6f * amplitude * wave;
+    return TRUE;
+}
+
+/* ---------------------------------------------------------------- world tint */
+void surreal_getWorldTint(s32 rgb[3]) {
+    f32 t = sSurrealTime * 0.23f;
+
+    rgb[0] = (s32)(222.0f + 33.0f * sinf(t));
+    rgb[1] = (s32)(222.0f + 33.0f * sinf(t + 2.094f));
+    rgb[2] = (s32)(222.0f + 33.0f * sinf(t + 4.189f));
+}
+
+/* ---------------------------------------------------------------- text */
+f32 surreal_getTextWave(f32 x) {
+    return 2.2f * sinf(sSurrealTime * 3.1f + x * 0.045f);
+}
+
+/* ---------------------------------------------------------------- sound
+ * Sound effects drift between about 80% and 120% of their normal pitch on a slow wave
+ * (the caller adds a little flutter with the sound system's own random numbers, so the
+ * gameplay random sequence is untouched). The engine's rates top out near 32750, so the
+ * result stays well inside the 16 bit value the audio driver takes. */
+f32 surreal_getPitchWarp(void) {
+    return 1.0f + 0.17f * sinf(sSurrealTime * 0.41f);
+}
+
+/* ---------------------------------------------------------------- sizes
+ * A cheap position hash gives every placed thing its own size, the same on every visit. */
+static u32 __surreal_hash(s32 x, s32 y, s32 z) {
+    u32 h = (u32)(x * 73856093) ^ (u32)(y * 19349663) ^ (u32)(z * 83492791);
+
+    h ^= h >> 13;
+    h *= 0x5BD1E995;
+    h ^= h >> 15;
+    return h;
+}
+
+/* Only fodder enemies: bosses, switches, doors and anything a puzzle measures stay as they were */
+static s16 sSurrealResizableEnemies[] = {
+    ACTOR_4_BIGBUTT, ACTOR_5_TERMITE, ACTOR_6_GRUBLIN, ACTOR_E_SMALL_BULL, ACTOR_12_BEEHIVE,
+    ACTOR_56_SHRAPNEL, ACTOR_67_SNIPPET, ACTOR_F2_BLACK_SNIPPET, ACTOR_F5_MUTIE_SNIPPET,
+    ACTOR_CA_TEEHEE, ACTOR_3C1_PURPLE_TEEHEE, ACTOR_124_SIR_SLUSH,
+    ACTOR_133_FLIBBIT_RED, ACTOR_137_FLIBBIT_YELLOW, ACTOR_134_BUZZBOMB, ACTOR_163_BAT,
+    ACTOR_34E_LIMBO, ACTOR_34F_MUMMUM, ACTOR_350_SEAMAN_GRUBLIN, ACTOR_375_GRUBLIN_HOOD,
+    ACTOR_367_GRUNTLING_RED, ACTOR_3BF_GRUNTLING_BLUE, ACTOR_3C0_GRUNTLING_BLACK,
+    ACTOR_36D_COLLYWOBBLE_B, ACTOR_36E_BAWL_THE_ONION_B, ACTOR_36F_TOPPER_THE_CARROT_B,
+    ACTOR_380_SCARAB_BEETLE, ACTOR_37D_ICECUBE_A, ACTOR_3A0_ICECUBE_B,
+    -1
+};
+
+f32 surreal_getEnemyScale(s32 actor_id, f32 position[3]) {
+    s32 i;
+    u32 h;
+
+    for (i = 0; sSurrealResizableEnemies[i] != -1; i++) {
+        if (actor_id == sSurrealResizableEnemies[i]) {
+            /* coarse grid, so a few units of settling on the first frame don't change the size */
+            h = __surreal_hash((s32)position[0] >> 4, (s32)position[1] >> 4, (s32)position[2] >> 4) % 100;
+#ifdef SURREAL_TEST_MAP
+            sSurrealDebugResized++;             /* dev only: counted for the on-screen readout */
+            if (h < 12) { sSurrealDebugGiants++; }
+            if (h >= 12 && h < 30) { sSurrealDebugTiny++; }
+#endif
+            if (h < 12) {
+                return 2.1f;                    /* one in eight is a giant */
+            }
+            if (h < 30) {
+                return 0.55f;                   /* some are pocket sized */
+            }
+            return 0.75f + (h - 30) * 0.011f;   /* the rest: 0.75x to 1.5x */
+        }
+    }
+    return 1.0f;
+}
+
+s32 surreal_getSpritePropScale(s32 scale, s16 position[3]) {
+    u32 h = __surreal_hash(position[0], position[1], position[2]) % 100;
+    s32 result;
+
+    /* 0.6x to 2.2x, weighted towards the small end so the giants stand out */
+    result = (scale * (60 + (s32)((h * h) / 62))) / 100;
+    return (result > 0xFF) ? 0xFF : ((result < 1) ? 1 : result);
+}
