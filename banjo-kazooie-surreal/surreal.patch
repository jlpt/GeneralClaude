+#ifndef BANJO_KAZOOIE_CORE2_SURREAL_H
+#define BANJO_KAZOOIE_CORE2_SURREAL_H
+
+#include <ultra64.h>
+#include "bool.h"
+
+/* "Surreal" mod: shared dream state. Implemented in src/core2/gc/surreal.inc
+ * (included from sky.c so no linker script changes are needed). */
+
+/* seconds of dream time; advances with the game clock (stops while paused) */
+f32  surreal_getTime(void);
+void surreal_update(void);
+
+/* sky */
+void surreal_sky_load(void);
+void surreal_sky_free(void);
+void surreal_sky_getTumble(f32 rotation[3]);
+void surreal_sky_drawObjects(Gfx **gfx, Mtx **mtx, f32 camera_position[3]);
+
+
+/* camera: called around the 3D world pass in gsworld_draw */
+void surreal_camera_begin(void);
+void surreal_camera_end(void);
+
+/* jelly: squash and stretch applied to every model except level geometry and the sky */
+void surreal_jelly_skipNext(void);
+bool surreal_jelly_getScale(f32 position[3], f32 radius, f32 scale[3]);
+
+/* sizes: stable per placement, so the same flower is always the same wrong size */
+f32  surreal_getEnemyScale(s32 actor_id, f32 position[3]);
+s32  surreal_getSpritePropScale(s32 scale, s16 position[3]);
+
+/* multiplier for sound effect playback rates: slow tape wow */
+f32  surreal_getPitchWarp(void);
+
+/* vertical offset, in pixels, for a letter drawn at screen x */
+f32  surreal_getTextWave(f32 x);
+
+/* slow colour drift multiplied into the level geometry */
+void surreal_getWorldTint(s32 rgb[3]);
+
+#endif
